namespace WhiteBirdEngine {

namespace {

// Extracts the parameter type of a render task's create() and rejects any other signature. A task type that resolves
// resources registered on its render graph declares the overload that also takes the graph.
template <typename TCreate>
struct RendTaskCreateTraits {
    static constexpr bool IS_VALID = false;
};

template <typename TParams>
struct RendTaskCreateTraits<Unique<IRendTaskVK> (*)(const RendContextVK*, const TParams&, const RendGraphContextVK&)> {
    static constexpr bool IS_VALID = true;
    static constexpr bool TAKES_GRAPH = false;
    using Params = TParams;
};

template <typename TParams>
struct RendTaskCreateTraits<Unique<IRendTaskVK> (*)(const RendContextVK*, IRendGraph*, const TParams&, const RendGraphContextVK&)> {
    static constexpr bool IS_VALID = true;
    static constexpr bool TAKES_GRAPH = true;
    using Params = TParams;
};

template <typename TTask>
using RendTaskTraits = RendTaskCreateTraits<decltype(&TTask::create)>;

template <typename TTask>
RendTaskFactoryVK make_create_factory(const RendContextVK* p_rend_data, IRendGraph* p_rend_graph, typename RendTaskTraits<TTask>::Params p_params) {
    static_assert(RendTaskTraits<TTask>::IS_VALID,
        "A WBE_REND_TASK must declare static Unique<IRendTaskVK> create(const RendContextVK*, [IRendGraph*,] const TParams&, const RendGraphContextVK&).");
    return [p_rend_data, p_rend_graph, params = std::move(p_params)](const RendGraphContextVK& p_context) {
        if constexpr (RendTaskTraits<TTask>::TAKES_GRAPH) {
            return TTask::create(p_rend_data, p_rend_graph, params, p_context);
        } else {
            static_cast<void>(p_rend_graph);
            return TTask::create(p_rend_data, params, p_context);
        }
    };
}

template <typename TTask>
typename RendTaskTraits<TTask>::Params deserialize_rend_task_params(const DataValue& p_params) {
    static_assert(RendTaskTraits<TTask>::IS_VALID,
        "A WBE_REND_TASK must declare static Unique<IRendTaskVK> create(const RendContextVK*, [IRendGraph*,] const TParams&, const RendGraphContextVK&).");
    typename RendTaskTraits<TTask>::Params params{};
    SerializableSD<typename RendTaskTraits<TTask>::Params>::deserialize(p_params, params);
    return params;
}

template <typename TTask>
RendTaskFactoryVK make_rend_task_factory(const DataValue& p_params, const RendContextVK* p_rend_data, IRendGraph* p_rend_graph) {
    return make_create_factory<TTask>(p_rend_data, p_rend_graph, deserialize_rend_task_params<TTask>(p_params));
}

template <typename TTask>
RendTaskDescVK& add_rend_task(RendGraphDescVK& p_graph, std::string_view p_task_id, const DataValue& p_params, const RendContextVK* p_rend_data) {
    auto params = deserialize_rend_task_params<TTask>(p_params);
    RendTaskDescVK task(p_graph.alloc, p_task_id, make_create_factory<TTask>(p_rend_data, p_graph.rend_graph, params));
    if constexpr (requires { TTask::prepare_graph(p_graph, task, params, p_rend_data); }) {
        TTask::prepare_graph(p_graph, task, params, p_rend_data);
    }
    p_graph.add_task(std::move(task));
    return p_graph.get_task(p_task_id);
}

template <typename TTask>
RendTaskFactoryVK prepare_rend_task(RendGraphDescVK& p_graph, RendTaskDescVK& p_task, const DataValue& p_params, const RendContextVK* p_rend_data) {
    auto params = deserialize_rend_task_params<TTask>(p_params);
    if constexpr (requires { TTask::prepare_graph(p_graph, p_task, params, p_rend_data); }) {
        TTask::prepare_graph(p_graph, p_task, params, p_rend_data);
    }
    return make_create_factory<TTask>(p_rend_data, p_graph.rend_graph, std::move(params));
}

struct RendTaskTypeEntry {
    std::string_view name;
    RendTaskFactoryVK (*make_factory)(const DataValue&, const RendContextVK*, IRendGraph*);
    RendTaskDescVK& (*add_task)(RendGraphDescVK&, std::string_view, const DataValue&, const RendContextVK*);
    RendTaskFactoryVK (*prepare_task)(RendGraphDescVK&, RendTaskDescVK&, const DataValue&, const RendContextVK*);
};

// The dispatch table, in the same order as REND_TASK_TYPE_NAMES.
constexpr std::array<RendTaskTypeEntry, {{ registry.names | length }}> REND_TASK_TYPES = { {
{% for task in registry.entries %}
{% for name in [task.name] + task.aliases %}
    {.name = "{{ name }}",
        .make_factory = &make_rend_task_factory<{{ task.name }}>,
        .add_task = &add_rend_task<{{ task.name }}>,
        .prepare_task = &prepare_rend_task<{{ task.name }}>},
{% endfor %}
{% endfor %}
} };

constexpr std::array<std::string_view, {{ registry.names | length }}> REND_TASK_TYPE_NAMES = { {
{% for name in registry.names %}
    "{{ name }}",
{% endfor %}
} };

const RendTaskTypeEntry* find_rend_task_type(std::string_view p_task_type) {
    for (const RendTaskTypeEntry& entry : REND_TASK_TYPES) {
        if (entry.name == p_task_type) {
            return &entry;
        }
    }
    return nullptr;
}

} // namespace

RendTaskFactoryVK RendTaskRegistryVK::create_factory(
    std::string_view p_task_type, const DataValue& p_params, const RendContextVK* p_rend_data, IRendGraph* p_rend_graph) {
    const RendTaskTypeEntry* entry = find_rend_task_type(p_task_type);
    if (entry == nullptr) {
        throw std::runtime_error(std::format("Failed to create render task factory: unknown render task type '{}'.", p_task_type));
    }
    if (p_rend_data == nullptr) {
        throw std::runtime_error(std::format("Failed to create render task factory for '{}': render data is null.", p_task_type));
    }
    return entry->make_factory(p_params, p_rend_data, p_rend_graph);
}

RendTaskDescVK& RendTaskRegistryVK::add_task(RendGraphDescVK& p_graph,
    std::string_view p_task_id,
    std::string_view p_task_type,
    const DataValue& p_params,
    const RendContextVK* p_rend_data) {
    const RendTaskTypeEntry* entry = find_rend_task_type(p_task_type);
    if (entry == nullptr) {
        throw std::runtime_error(std::format("Failed to add render task '{}': unknown render task type '{}'.", p_task_id, p_task_type));
    }
    if (p_rend_data == nullptr) {
        throw std::runtime_error(std::format("Failed to add render task '{}' of type '{}': render data is null.", p_task_id, p_task_type));
    }
    if (p_task_id.empty()) {
        throw std::runtime_error(std::format("Failed to add render task of type '{}': the task id is empty.", p_task_type));
    }
    if (std::ranges::any_of(p_graph.tasks, [p_task_id](const RendTaskDescVK& p_task) {
            return p_task.task_id == p_task_id;
        })) {
        throw std::runtime_error(std::format("Failed to add render task '{}': the graph already has a task with this id.", p_task_id));
    }
    return entry->add_task(p_graph, p_task_id, p_params, p_rend_data);
}

RendTaskFactoryVK RendTaskRegistryVK::prepare_task(RendGraphDescVK& p_graph,
    RendTaskDescVK& p_task,
    std::string_view p_task_type,
    const DataValue& p_params,
    const RendContextVK* p_rend_data) {
    const RendTaskTypeEntry* entry = find_rend_task_type(p_task_type);
    if (entry == nullptr) {
        throw std::runtime_error(std::format("Failed to prepare render task '{}': unknown render task type '{}'.", p_task.task_id, p_task_type));
    }
    if (p_rend_data == nullptr) {
        throw std::runtime_error(
            std::format("Failed to prepare render task '{}' of type '{}': render data is null.", p_task.task_id, p_task_type));
    }
    return entry->prepare_task(p_graph, p_task, p_params, p_rend_data);
}

bool RendTaskRegistryVK::contains(std::string_view p_task_type) {
    return std::ranges::find(REND_TASK_TYPE_NAMES, p_task_type) != REND_TASK_TYPE_NAMES.end();
}

std::span<const std::string_view> RendTaskRegistryVK::get_task_types() {
    return REND_TASK_TYPE_NAMES;
}

} // namespace WhiteBirdEngine
