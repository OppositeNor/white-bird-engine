namespace WhiteBirdEngine {

namespace {

// Extracts the parameter type of a render task's create() and rejects any other signature.
template <typename TCreate>
struct RenderTaskCreateTraits {
    static constexpr bool IS_VALID = false;
};

template <typename TParams>
struct RenderTaskCreateTraits<Unique<IRenderTaskVK> (*)(const BaseRenderDataVK*, const TParams&, const RendGraphContextVK&)> {
    static constexpr bool IS_VALID = true;
    using Params = TParams;
};

template <typename TTask, typename TParserData>
RendTaskFactoryVK make_render_task_factory(const TParserData& p_params, const BaseRenderDataVK* p_render_data) {
    using Traits = RenderTaskCreateTraits<decltype(&TTask::create)>;
    static_assert(Traits::IS_VALID,
        "A WBE_RENDER_TASK must declare static Unique<IRenderTaskVK> create(const BaseRenderDataVK*, const TParams&, const RendGraphContextVK&).");
    typename Traits::Params params{};
    SerializableSD<typename Traits::Params>::deserialize(p_params, params);
    return [p_render_data, params = std::move(params)](const RendGraphContextVK& p_context) {
        return TTask::create(p_render_data, params, p_context);
    };
}

template <typename TParserData>
struct RenderTaskTypeEntry {
    std::string_view name;
    RendTaskFactoryVK (*make_factory)(const TParserData&, const BaseRenderDataVK*);
};

// One dispatch table per parser data type, in the same order as RENDER_TASK_TYPE_NAMES.
template <typename TParserData>
constexpr std::array<RenderTaskTypeEntry<TParserData>, {{ registry.names | length }}> RENDER_TASK_TYPES = { {
{% for task in registry.entries %}
{% for name in [task.name] + task.aliases %}
    {.name = "{{ name }}", .make_factory = &make_render_task_factory<{{ task.name }}, TParserData>},
{% endfor %}
{% endfor %}
} };

constexpr std::array<std::string_view, {{ registry.names | length }}> RENDER_TASK_TYPE_NAMES = { {
{% for name in registry.names %}
    "{{ name }}",
{% endfor %}
} };

template <typename TParserData>
const RenderTaskTypeEntry<TParserData>* find_render_task_type(std::string_view p_task_type) {
    for (const RenderTaskTypeEntry<TParserData>& entry : RENDER_TASK_TYPES<TParserData>) {
        if (entry.name == p_task_type) {
            return &entry;
        }
    }
    return nullptr;
}

} // namespace

template <RenderTaskParamsDataConcept TParserData>
RendTaskFactoryVK RenderTaskRegistryVK::create_factory(std::string_view p_task_type, const TParserData& p_params, const BaseRenderDataVK* p_render_data) {
    const RenderTaskTypeEntry<TParserData>* entry = find_render_task_type<TParserData>(p_task_type);
    if (entry == nullptr) {
        throw std::runtime_error(std::format("Failed to create render task factory: unknown render task type '{}'.", p_task_type));
    }
    if (p_render_data == nullptr) {
        throw std::runtime_error(std::format("Failed to create render task factory for '{}': render data is null.", p_task_type));
    }
    return entry->make_factory(p_params, p_render_data);
}

bool RenderTaskRegistryVK::contains(std::string_view p_task_type) {
    return std::ranges::find(RENDER_TASK_TYPE_NAMES, p_task_type) != RENDER_TASK_TYPE_NAMES.end();
}

std::span<const std::string_view> RenderTaskRegistryVK::get_task_types() {
    return RENDER_TASK_TYPE_NAMES;
}

// Keep in sync with RenderTaskParamsDataConcept.
template RendTaskFactoryVK RenderTaskRegistryVK::create_factory<JSONData>(std::string_view, const JSONData&, const BaseRenderDataVK*);
template RendTaskFactoryVK RenderTaskRegistryVK::create_factory<TOMLData>(std::string_view, const TOMLData&, const BaseRenderDataVK*);
template RendTaskFactoryVK RenderTaskRegistryVK::create_factory<ScriptValue>(std::string_view, const ScriptValue&, const BaseRenderDataVK*);

} // namespace WhiteBirdEngine
