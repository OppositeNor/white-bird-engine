-- {{ _prefix }}
-- Shared render graph declarations. The runtime helpers implement these operations in render_graph_utils.render_graph_utils.
-- Task parameter interfaces and constructors come from reflected render-task classes and their resource annotations.
{% set api = metadata | teal_render_tasks(render_tasks, reflect_script) %}
{% set dispatch = namespace(type="wbe.RTParamsComputeDispatchVK") %}
{% for interface in api.interfaces if interface.name == "RTParamsComputeDispatchVK" %}
{% set dispatch.type = interface.name %}
{% endfor %}

local type wbe = require("wbe")

local record render_graph
    -- A resource the recipe declares (a buffer, image, image view, or sampler, whose id the graph generates when it is
    -- built), an import C++ supplies, a member of an imported composite, a subgraph port, or a registered entry. A view
    -- retains its source image.
    record Resource
        kind: string
        -- The id of an import or member, the name of a port, or the key of a registered entry; nil for a declared resource.
        key: string
        -- The debug name of a declared resource.
        name: string
        resource_type: string
        description: wbe.RendRecipeResourceVK
        -- The registration a registered handle carries; a task whose params name the handle emits it.
        registration: wbe.RendRecipeRegistrationVK
        dependencies: {Resource}
        -- The image's default view, or a new view of it configured by view.
        view: function(self: Resource, view?: ImageViewDescriptor): Resource
        -- A member of an imported composite, which C++ registers as `<import id>.<member>`.
        member: function(self: Resource, name: string): Resource
    end

    -- The descriptors of declared resources: their reflected parameters and an optional debug name, which names the
    -- objects the graph creates for them.
    interface BufferDescriptor is wbe.RendBufferParamsVK
        name: string
    end

    interface ImageDescriptor is wbe.RendImageParamsVK
        name: string
    end

    interface ImageViewDescriptor is wbe.RendImageViewParamsVK
        name: string
    end

    interface SamplerDescriptor is wbe.RendSamplerParamsVK
        name: string
    end

    -- Options of a task: its debug name, the resource of every name its shaders and render targets use, and its gating.
    record TaskOptions
        name: string
        bindings: {string:Resource}
        trigger: wbe.RendRecipeTriggerVK
        toggle: wbe.RendRecipeToggleVK
    end

    record Edge
        to: Task
        resource: Resource
    end

    -- A typed task, a task C++ supplies (an import), a multiplexer, or a subgraph, whose id the build generates, except an
    -- import's. Bindings map task-local names to resources without ordering anything; edges order the task before others.
    record Task
        kind: string
        -- The id of an imported task.
        key: string
        -- The debug name.
        name: string
        ["type"]: string
        params: any
        -- The resource fields of a typed task's params, which the build lowers.
        fields: any
        bindings: {string:Resource}
        edges: {Edge}
        trigger: wbe.RendRecipeTriggerVK
        toggle: wbe.RendRecipeToggleVK
        select: wbe.RendRecipeSelectVK
        branch_tasks: {Task}
        subgraph_tasks: {Task}
        ports: {string:Resource}
        bind: function(self: Task, local_name: string, resource: Resource): Task
        connect: function(self: Task, next_task: Task, resource: Resource): Task
        connect: function(self: Task, next_task: Task, resources: {Resource}): Task
        connect_all: function(self: Task, next_tasks: {Task}, resource: Resource): Task
        connect_all: function(self: Task, next_tasks: {Task}, resources: {Resource}): Task
        inputs_from: function(self: Task, producer: Task, bindings: {string:Resource}): Task
        color_target: function(self: Task, index: integer, resource: Resource): Task
        depth_target: function(self: Task, resource: Resource): Task
    end

    -- A multiplexer: typed branches built without edges, triggers, or toggles, the branch selection, and what applies to
    -- the multiplexer as a whole.
    record MultiplexDescriptor
        name: string
        branches: {Task}
        select: wbe.RendRecipeSelectVK
        bindings: {string:Resource}
        trigger: wbe.RendRecipeTriggerVK
        toggle: wbe.RendRecipeToggleVK
    end

    -- A subgraph: its tasks in order, and the resource of the enclosing graph each port name its tasks use is bound to.
    record SubgraphDescriptor
        name: string
        tasks: {Task}
        ports: {string:Resource}
        trigger: wbe.RendRecipeTriggerVK
        toggle: wbe.RendRecipeToggleVK
    end

    -- A recipe: its tasks in order, which sets the generated ids, and the resources C++ acquires by name
    -- (RenderGraphVK::acquire_resource()).
    record BuildDescriptor
        tasks: {Task}
        exports: {string:Resource}
    end
{% for interface in api.interfaces %}

    interface {{ interface.name }}
{% for field in interface.fields %}
        {{ field.name }}: {{ field.type }}
{% endfor %}
    end
{% endfor %}

    enum_name: function(value: string): string
    buffer: function(descriptor: BufferDescriptor): Resource
    -- A buffer of usage buffer_storage.
    storage_buffer: function(descriptor: BufferDescriptor): Resource
    image: function(descriptor: ImageDescriptor): Resource
    -- An image of usage image_read_write.
    storage_image: function(descriptor: ImageDescriptor): Resource
    image_view: function(image: Resource, descriptor?: ImageViewDescriptor): Resource
    clamp_to_edge_sampler: function(descriptor?: SamplerDescriptor): Resource
    -- Entries registered on the render graph under key. With a description, the handle registers the entry: the build
    -- emits the registration when a task names the handle, merging equal registrations of a key; without one, it names an
    -- entry registered elsewhere.
    mesh: function(key: string, description?: wbe.RDParamsMeshVK): Resource
    compute_pipeline: function(key: string, description?: wbe.RDParamsComputePipelineVK): Resource
    graphics_pipeline: function(key: string, description?: wbe.RDParamsGraphicsPipelineVK): Resource
    -- A compute pipeline compiled from the shader shader and registered under the same key.
    shader_compute_pipeline: function(shader: string): Resource
    -- An entry of a custom description type: type_name is the reflected name of the description struct, which selects the
    -- registrator, and resource_type the C++ type of the registered object.
    registered_resource: function(key: string, type_name: string, description: any, resource_type: string): Resource
    -- A registered image, bound like an import.
    registered_image: function(key: string, description: wbe.RDParamsImageVK): Resource
    -- A resource C++ supplies under id.
    import: function(id: string): Resource
    port: function(name: string): Resource
    indirect_dispatch: function(pipeline: Resource, indirect_buffer: Resource, offset: integer,
        bindings?: {string:Resource}): {{ dispatch.type }}
{% for constructor in api.constructors %}
    {{ constructor.method }}: function(params: {{ constructor.params_type }}, options?: TaskOptions): Task
{% endfor %}
    -- A task of a registered type without a constructor, whose params name no resource.
    task: function(type_name: string, params: any, options?: TaskOptions): Task
    -- A task C++ supplies under id.
    import_task: function(id: string): Task
    multiplex: function(descriptor: MultiplexDescriptor): Task
    subgraph: function(descriptor: SubgraphDescriptor): Task
    -- Order tasks on every resource, each after the one before it.
    chain: function(resource: Resource, tasks: {Task})
    chain: function(resources: {Resource}, tasks: {Task})
    -- Generate the ids of the declared resources and tasks the recipe reaches, and emit it.
    build: function(descriptor: BuildDescriptor): wbe.RendGraphRecipeVK
end

return render_graph
