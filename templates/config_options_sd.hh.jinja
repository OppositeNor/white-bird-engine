namespace WhiteBirdEngine {

{% for config_option in metadata.structs %}
{% if config_option.attribute | select("in", config_options) | list | length > 0  %}
/**
 * @class ConfigOptionsSD<{{ config_option.name }}>
 * @brief Config options serializer-deserializer for {{ config_option.name }}.
 */
template <>
class ConfigOptionsSD<{{ config_option.name }}> {
public:
    ConfigOptionsSD() = default;
    ~ConfigOptionsSD() {}
    ConfigOptionsSD(const ConfigOptionsSD&) = delete;
    ConfigOptionsSD(ConfigOptionsSD&&) = delete;
    ConfigOptionsSD& operator=(const ConfigOptionsSD&) = delete;
    ConfigOptionsSD& operator=(ConfigOptionsSD&&) = delete;

    using ConfigType = {{ config_option.name }};

    /**
     * @brief Serialize a config option.
     *
     * @param p_config_option The config option to serialize.
     */
    template <typename Serializer>
    void serialize(Serializer& p_serializer, const ConfigType& p_config_option) {
        p_serializer.push_context("{{ config_option.name }}");
        {% for field in config_option.fields %}
        p_serializer.register_serialize("{{ field.name }}", p_config_option.{{ field.name }});
        {% endfor %}
        p_serializer.pop_context();
    }

    /**
     * @brief Deserialize a config option.
     *
     * @param p_config_option The config to deserialize.
     */
    template <typename ParserData>
    void deserialize(const ParserData& p_data, ConfigType& p_config_option) {
        {% for field in config_option.fields %}
        p_data.get_value("{{ field.name }}", p_config_option.{{ field.name }});
        {% endfor %}
    }
};
{% endif %}
{% endfor %}

}
