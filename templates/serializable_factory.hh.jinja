#ifndef WBE_FILE_SERIALIZABLE_FACTORY_GEN_HH
#define WBE_FILE_SERIALIZABLE_FACTORY_GEN_HH

#include "core/engine_core.hh"
#include "core/reflection/reflection_defs.hh"
#include "generated/serializables_sd.gen.hh"
#include <concepts>
#include <new>
#include <stdexcept>
#include <string>
#include <string_view>

{% for serializable in metadata.classes %}
{% if serializable.attribute | select("in", serializables) | list | length > 0  %}
#include "{{ serializable.in_header }}"
{% endif %}
{% endfor %}

namespace WhiteBirdEngine {

template <typename SerializableType, typename ParserDataType>
constexpr bool SERIALIZABLE_FACTORY_DESERIALIZABLE_FROM_PARSER = requires(const ParserDataType& p_data, SerializableType& p_serializable) {
    SerializableSD<SerializableType>::deserialize(p_data, p_serializable);
};

class SerializableFactory {
public:
    SerializableFactory() = delete;
    ~SerializableFactory() = delete;
    SerializableFactory(const SerializableFactory&) = delete;
    SerializableFactory(SerializableFactory&&) = delete;
    SerializableFactory& operator=(const SerializableFactory&) = delete;
    SerializableFactory& operator=(SerializableFactory&&) = delete;

    template <typename ParserDataType>
    static void* create_serializable_object(std::string_view p_serializable_name, const ParserDataType& p_data, void* p_memory = nullptr) {
        {% for serializable in metadata.classes %}
        {% if serializable.attribute | select("in", serializables) | list | length > 0 and serializable.name != "Serializable" %}
        if (p_serializable_name == "{{ serializable.name }}") {
            if constexpr (SERIALIZABLE_FACTORY_DESERIALIZABLE_FROM_PARSER<{{ serializable.name }}, ParserDataType>) {
                return create_serializable_object_impl<{{ serializable.name }}>(p_data, p_memory);
            } else {
                throw std::runtime_error("Serializable type '" + std::string(p_serializable_name) + "' does not support this parser data type.");
            }
        }
        {% endif %}
        {% endfor %}
        throw std::runtime_error("Serializable type not found: " + std::string(p_serializable_name));
    }
private:
    template <typename SerializableType, typename ParserDataType>
    static void* create_serializable_object_impl(const ParserDataType& p_data, void* p_memory) {
        if (p_memory != nullptr) {
            SerializableType* serializable = new (p_memory) SerializableType();
            try {
                SerializableSD<SerializableType>::deserialize(p_data, *serializable);
            } catch (...) {
                serializable->~SerializableType();
                throw;
            }
            return serializable;
        }

        void* allocated_memory = ::operator new(sizeof(SerializableType), std::align_val_t(alignof(SerializableType)));
        SerializableType* serializable = new (allocated_memory) SerializableType();
        try {
            SerializableSD<SerializableType>::deserialize(p_data, *serializable);
        } catch (...) {
            serializable->~SerializableType();
            ::operator delete(allocated_memory, std::align_val_t(alignof(SerializableType)));
            throw;
        }
        return serializable;
    }
};

} // namespace WhiteBirdEngine

#endif