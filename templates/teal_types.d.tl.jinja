-- {{ _prefix }}
-- Teal declarations of the reflected engine types for render graph recipe scripts, which the ACP type-checks Teal
-- scripts against. Scripts import them as types only, with `local type wbe = require("wbe")`, which generates no code.
{% set reflected = namespace(enums=[], enum_names=[], classes=[], class_names=[], by_name={}) %}
{% for enum in metadata.enums %}
{% if enum.attribute | select("in", reflected_enums) | list | length > 0 and "/tests/" not in enum.in_header %}
{% set reflected.enums = reflected.enums + [enum] %}
{% set reflected.enum_names = reflected.enum_names + [enum.name] %}
{% endif %}
{% endfor %}
{% for class in metadata.classes %}
{% if "/tests/" not in class.in_header and class.attribute | select("in", static_serializables) | list | length > 0 %}
{% set reflected.classes = reflected.classes + [class] %}
{% set reflected.class_names = reflected.class_names + [class.name] %}
{% set _ = reflected.by_name.update({class.name: class}) %}
{% endif %}
{% endfor %}
{#- Teal records inherit only interfaces, so a record repeats the fields of its reflected parents, parents first. #}
{% macro fields(class) %}
{% for parent in class.extended_parents if parent in reflected.by_name %}
{{ fields(reflected.by_name[parent]) }}
{%- endfor %}
{% for field in class.fields %}
{% set field_type = field.type | teal_type(reflected.class_names, reflected.enum_names) %}
        {{ field.name | teal_field_name }}: {{ field_type }}
{% for alias in field.aliases %}
        {{ alias | teal_field_name }}: {{ field_type }}
{% endfor %}
{% endfor %}
{%- endmacro %}
local record wbe
    record Vec2
        x: number
        y: number
        u: number
        v: number
    end

    record Vec3
        x: number
        y: number
        z: number
    end

    record Vec4
        x: number
        y: number
        z: number
        w: number
    end

    record Quat
        x: number
        y: number
        z: number
        w: number
    end
{% for enum in reflected.enums %}

    enum {{ enum.name | teal_name }}
{% for value in enum["values"] if "WBE_REFLECT_ENUM_IGNORE" not in value.attribute %}
{% for name in [value.name] + value.aliases %}
        "{{ name }}"
{% endfor %}
{% endfor %}
    end
{% endfor %}
{% for class in reflected.classes %}

    record {{ class.name | teal_name }}
{{ fields(class) | trim("\n") }}
    end
{% endfor %}

    record RecipeExtent2D
        width: integer
        height: integer
    end

    -- Renderer facts passed to a recipe's `build(context)`. A recipe declares the entries its application adds with a
    -- record that is this interface, such as `local record Context is wbe.RecipeContext`.
    interface RecipeContext
        frames_in_flight: integer
        swap_chain_format: ImageFormatVK | integer
        swap_chain_extent: RecipeExtent2D
    end
end

return wbe
