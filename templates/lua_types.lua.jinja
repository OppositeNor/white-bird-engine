---@meta
-- {{ _prefix }}
-- Editor type stubs (LuaLS / EmmyLua) for render graph recipe scripts. Never executed by the engine.
{% set reflected = namespace(enums=[], enum_names=[], classes=[], class_names=[], tasks=[]) %}
{% for enum in metadata.enums %}
{% if enum.attribute | select("in", reflected_enums) | list | length > 0 and "/tests/" not in enum.in_header %}
{% set reflected.enums = reflected.enums + [enum] %}
{% set reflected.enum_names = reflected.enum_names + [enum.name] %}
{% endif %}
{% endfor %}
{% for class in metadata.classes %}
{% if "/tests/" not in class.in_header %}
{% if class.attribute | select("in", static_serializables) | list | length > 0 %}
{% set reflected.classes = reflected.classes + [class] %}
{% set reflected.class_names = reflected.class_names + [class.name] %}
{% endif %}
{% if class.attribute | select("in", render_tasks) | list | length > 0 %}
{% set reflected.tasks = reflected.tasks + [class] %}
{% endif %}
{% endif %}
{% endfor %}

---@class wbe.Vec2
---@field x? number
---@field y? number
---@field u? number
---@field v? number

---@class wbe.Vec3
---@field x? number
---@field y? number
---@field z? number

---@class wbe.Vec4
---@field x? number
---@field y? number
---@field z? number
---@field w? number

---@class wbe.Quat
---@field x? number
---@field y? number
---@field z? number
---@field w? number
{% for enum in reflected.enums %}

---@alias {{ enum.name | lua_class_name }}
{% for value in enum["values"] if "WBE_REFLECT_ENUM_IGNORE" not in value.attribute %}
{% for name in [value.name] + value.aliases %}
---| "{{ name }}"
{% endfor %}
{% endfor %}
---| integer
{% endfor %}
{% for class in reflected.classes %}

---@class {{ class.name | lua_class_name }}{% for parent in class.extended_parents if parent in reflected.class_names %}{% if loop.first %} : {% else %}, {% endif %}{{ parent | lua_class_name }}{% endfor %}

{% for field in class.fields %}
{% set field_type = field.type | lua_type(reflected.class_names, reflected.enum_names) %}
{% if class.name == "RendGraphRecipeVK" and field.name == "tasks" %}
{% set field_type = "wbe.RecipeTask[]" %}
{% endif %}
{% set optional = "" if "WBE_REFLECT_REQUIRED" in field.attribute else "?" %}
---@field {{ field.name }}{{ optional }} {{ field_type }}
{% for alias in field.aliases %}
---@field {{ alias }}? {{ field_type }} Alias of `{{ field.name }}`.
{% endfor %}
{% endfor %}
{% endfor %}
{% for task in reflected.tasks %}
{% set params = namespace(type="") %}
{% for method in task.methods if method.method_name == "create" and method.is_static %}
{% set params.type = method.type | lua_task_params_type %}
{% endfor %}

---@class wbe.task.{{ task.name }} : wbe.RendRecipeTaskVK
---@field type {% for name in [task.name] + task.aliases %}"{{ name }}"{% if not loop.last %}|{% endif %}{% endfor %}

{% if params.type in reflected.class_names %}
---@field params? {{ params.type | lua_class_name }}
{% endif %}
{% endfor %}

---A task the application supplies through RendGraphRecipeImportsVK::add_task() under the same id; the recipe can only
---connect it.
---@class wbe.ImportedTask
---@field id string
---@field import true
---@field connect? wbe.RendRecipeEdgeVK[]

---@alias wbe.RecipeTask
---| wbe.ImportedTask
{% for task in reflected.tasks %}
---| wbe.task.{{ task.name }}
{% endfor %}
---| wbe.RendRecipeTaskVK

---Renderer facts passed to a recipe's `build(context)`, plus any entries the application adds. The recipe re-runs when
---they change, such as after a swap chain resize.
---@class wbe.RecipeContext
---@field frames_in_flight integer
---@field swap_chain_format wbe.ImageFormatVK
---@field swap_chain_extent { width: integer, height: integer }
---@field [string] any

---The exports table a render graph recipe script returns.
---@class wbe.RecipeModule
---@field build fun(context: wbe.RecipeContext): wbe.RendGraphRecipeVK

return {}
