-- {{ _prefix }}
-- Installs the constructors of the render tasks annotated WBE_RENDER_TASK(<method>). Public graph and params types live
-- in render_graph; this implementation module only describes fields for lowering and installs task constructors.
{% set api = metadata | teal_render_tasks(render_tasks, reflect_script) %}

local type render_graph = require("render_graph_utils.render_graph")

local record render_graph_tasks
    -- A params field that holds resource ids: an id ("resource"), or a list, a map, or a record of nested fields that
    -- hold them. A "graph" id names a graph resource, which the task binds to itself, and a "registered" key identifies an
    -- entry of expected_type registered on the render graph.
    enum ResourceFieldKind
        "resource"
        "list"
        "map"
        "record"
    end

    enum ResourceScope
        "graph"
        "registered"
    end

    record ResourceField
        name: string
        kind: ResourceFieldKind
        scope: ResourceScope
        expected_type: string
        element: ResourceField
        fields: {ResourceField}
    end
end
{% macro field_literal(field) -%}
{ {% if field.name is defined %}name = "{{ field.name }}", {% endif %}kind = "{{ field.kind }}"
{%- if field.scope is defined %}, scope = "{{ field.scope }}"{% endif %}
{%- if field.expected_type is defined %}, expected_type = "{{ field.expected_type }}"{% endif %}
{%- if field.element is defined %}, element = {{ field_literal(field.element) }}{% endif %}
{%- if field.fields is defined %}, fields = { {% for child in field.fields %}{{ field_literal(child) }}{% if not loop.last %}, {% endif %}{% endfor %} }{% endif %} }
{%- endmacro %}
{% for constructor in api.constructors %}

local {{ constructor.method }}_fields: {render_graph_tasks.ResourceField} = {
{% for field in constructor.fields %}
    {{ field_literal(field) }},
{% endfor %}
}
{% endfor %}

-- Install the constructors on the render_graph module. Each passes its task type, params, options, and resource fields to
-- make_task.
function render_graph_tasks.install(module: render_graph,
    make_task: function(type_name: string, params: any, options: render_graph.TaskOptions,
        fields: {render_graph_tasks.ResourceField}): render_graph.Task)
{% for constructor in api.constructors %}
    module.{{ constructor.method }} = function(params: any, options?: render_graph.TaskOptions): render_graph.Task
        return make_task("{{ constructor.type }}", params, options, {{ constructor.method }}_fields)
    end
{% endfor %}
end

return render_graph_tasks
