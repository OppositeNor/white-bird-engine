-- {{ _prefix }}
-- The constructors of the render tasks annotated WBE_RENDER_TASK(<method>), which utils.render_graph installs on its
-- graphs, and the authoring interfaces of their params, which accept resource handles in place of the resource ids of
-- WBE_RECIPE_RESOURCE fields. Resource, Task, TaskOptions, and Self are the types of utils.render_graph, which passes them
-- as type arguments because this module cannot require it.
{% set api = metadata | teal_render_tasks(render_tasks, reflect_script) %}

local type wbe = require("wbe")

local record render_graph_tasks
    -- A params field that holds resource ids: an id ("resource"), or a list, a map, or a record of nested fields that
    -- hold them. A "graph" id names a graph resource, and a "task_local" id names one through the task's aliases.
    enum ResourceFieldKind
        "resource"
        "list"
        "map"
        "record"
    end

    enum ResourceScope
        "graph"
        "task_local"
    end

    record ResourceField
        name: string
        kind: ResourceFieldKind
        scope: ResourceScope
        element: ResourceField
        fields: {ResourceField}
    end
{% for interface in api.interfaces %}

    interface {{ interface.name }}<Resource>
{% for field in interface.fields %}
        {{ field.name }}: {{ field.type }}
{% endfor %}
    end
{% endfor %}

    interface Graph<Resource, Task, TaskOptions, Self>
{% for constructor in api.constructors %}
        {{ constructor.method }}: function(self: Self, p_id: string, p_params: {{ constructor.params_type }},
            p_options?: TaskOptions): Task
{% endfor %}
    end
end
{% macro field_literal(field) -%}
{ {% if field.name is defined %}name = "{{ field.name }}", {% endif %}kind = "{{ field.kind }}"
{%- if field.scope is defined %}, scope = "{{ field.scope }}"{% endif %}
{%- if field.element is defined %}, element = {{ field_literal(field.element) }}{% endif %}
{%- if field.fields is defined %}, fields = { {% for child in field.fields %}{{ field_literal(child) }}{% if not loop.last %}, {% endif %}{% endfor %} }{% endif %} }
{%- endmacro %}
{% for constructor in api.constructors %}

local {{ constructor.method }}_fields: {render_graph_tasks.ResourceField} = {
{% for field in constructor.fields %}
    {{ field_literal(field) }},
{% endfor %}
}
{% endfor %}

-- Install the constructors on a graph. Each passes its id, task type, params, options, and resource fields to make_task.
function render_graph_tasks.install<Resource, Task, TaskOptions, Self>(
    p_graph: render_graph_tasks.Graph<Resource, Task, TaskOptions, Self>,
    p_make_task: function(p_id: string, p_type: string, p_params: any, p_options: TaskOptions,
        p_fields: {render_graph_tasks.ResourceField}): Task)
{% for constructor in api.constructors %}
    p_graph.{{ constructor.method }} = function(_self: Self, p_id: string, p_params: any, p_options?: TaskOptions): Task
        return p_make_task(p_id, "{{ constructor.type }}", p_params, p_options, {{ constructor.method }}_fields)
    end
{% endfor %}
end

return render_graph_tasks
