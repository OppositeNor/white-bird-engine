#ifndef __WBE_SERIALIZABLES_SD_HH__
#define __WBE_SERIALIZABLES_SD_HH__

#include "utils/utils.hh"
{% for serializable in metadata.structs %}
{% if serializable.attribute | select("in", serializables) | list | length > 0  %}
#include "{{ serializable.in_header }}"
{% endif %}
{% endfor %}

namespace WhiteBirdEngine {

{% for serializable in metadata.structs %}
{% if serializable.attribute | select("in", serializables) | list | length > 0  %}
/**
 * @class SerializableSD<{{ serializable.name }}>
 * @brief Serializer/deserializer for {{ serializable.name }}.
 */
template <>
class SerializableSD<{{ serializable.name }}> {
public:
    SerializableSD() = default;
    ~SerializableSD() {}
    SerializableSD(const SerializableSD&) = delete;
    SerializableSD(SerializableSD&&) = delete;
    SerializableSD& operator=(const SerializableSD&) = delete;
    SerializableSD& operator=(SerializableSD&&) = delete;

    using ObjType = {{ serializable.name }};

    /**
     * @brief Serialize.
     *
     * @param p_serializable The object to serialize.
     */
    template <typename Serializer>
    void serialize(Serializer& p_serializer, const ObjType& p_serializable) {
        p_serializer.push_context("{{ serializable.name }}");
        {% for field in serializable.fields %}
        p_serializer.register_serialize("{{ field.name }}", p_serializable.{{ field.name }});
        {% endfor %}
        p_serializer.pop_context();
    }

    /**
     * @brief Deserialize.
     *
     * @param p_serializable The object to deserialize.
     */
    template <typename ParserData>
    void deserialize(const ParserData& p_data, ObjType& p_serializable) {
        {% for field in serializable.fields %}
        p_data.get_value("{{ field.name }}", p_serializable.{{ field.name }});
        {% endfor %}
    }
};
{% endif %}
{% endfor %}

}

#endif
